<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.a_chacon.chaski</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Chaski</name>
  <summary>A calmer way to read the web</summary>

  <description>
    <p>
      Chaski is a privacy-focused RSS and Atom feed reader with a modern interface,
      offline capabilities, feed organization, and full-text search.
    </p>
    <p>
      It supports OPML import/export and multiple account backends compatible with
      Google Reader APIs such as FreshRSS, Miniflux, and Tiny Tiny RSS.
    </p>
  </description>

  <developer id="io.github.a-chacon">
    <name>a-chacon</name>
  </developer>

  <launchable type="desktop-id">com.a_chacon.chaski.desktop</launchable>

  <url type="homepage">https://github.com/a-chacon/chaski-app</url>
  <url type="bugtracker">https://github.com/a-chacon/chaski-app/issues</url>
  <url type="vcs-browser">https://github.com/a-chacon/chaski-app</url>

  <provides>
    <binary>chaski</binary>
  </provides>

  <releases>
    <release version="0.6.3" date="2026-07-29"/>
  </releases>

